# Copy this file to .env and fill in your real keys. NEVER commit .env.
# "test" uses your General Portfolio keys, "competition" uses the Competition keys.
ROOSTOO_MODE=test

ROOSTOO_TEST_KEY=your_test_api_key
ROOSTOO_TEST_SECRET=your_test_secret

ROOSTOO_COMP_KEY=
ROOSTOO_COMP_SECRET=

ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Bot switches. DRY_RUN=true logs orders without sending them (the default).
DRY_RUN=true
# Live competition orders are refused unless this is set, and never on Windows.
# Set CONFIRM_COMPETITION=yes-on-ec2 ONLY in the .env on the EC2 instance.
CONFIRM_COMPETITION=
# Optional overrides (defaults live in settings.py)
# MIN_TRADES_PER_DAY=2
# ACTIVITY_HOUR_UTC=20
# Strategy: v4 (default; nearness-to-high trend + Hawkes, long/short, top-20 coins), v3 or v1 (rollbacks)
STRATEGY=v4
# Allow 1x short positions (the bot also switches to long-only by itself if the exchange refuses)
ALLOW_SHORTS=true
